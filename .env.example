# Gemini API Key (Obrigatório - Obtenha em https://aistudio.google.com/)
GEMINI_API_KEY=seu_token_aqui

# Timezone padrão do stack
TZ=America/Sao_Paulo

# Configurações do Banco de Dados (PostgreSQL)
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=ecommerce_pass

# Configurações do MCP Server
DATABASE_URL=postgresql+psycopg://ecommerce_user:ecommerce_pass@postgres:5432/ecommerce
REDIS_URL=redis://redis:6379/0
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8000

# Configurações do MCP Client
# (Aponte para localhost:8000 se rodar o cliente fora do Docker)
MCP_SERVER_URL=http://mcp-server:8000/mcp
